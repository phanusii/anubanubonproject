rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // The email allowed to perform admin operations. Keep in sync with firestore.rules.
    function isAdmin() {
      return request.auth != null
             && request.auth.token.email == 'phanu9818@anubanubon.ac.th';
    }

    // Admin-only listing/traversal of the uploads tree, so the dashboard can sum
    // total Storage usage (listAll walks the folder prefixes). Public reads of
    // individual files are still granted by the file-level rule below.
    match /uploads/{allPaths=**} {
      allow read: if isAdmin();
    }

    match /uploads/{year}/{month}/{fileName} {
      // Allow public read for portfolio showcase
      allow read: if true;

      // New files use the ticketed Apps Script → school Drive path. Anonymous
      // Storage creation is disabled to prevent quota abuse.
      allow create: if false;

      // Delete & Update restricted to the admin account.
      allow update, delete: if isAdmin();
    }
  }
}
