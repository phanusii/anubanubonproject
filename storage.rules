rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // The email allowed to perform admin operations. Keep in sync with firestore.rules.
    function isAdmin() {
      return request.auth != null
             && request.auth.token.email == '18403p@gmail.com';
    }

    match /uploads/{year}/{month}/{fileName} {
      // Allow public read for portfolio showcase
      allow read: if true;

      // Public submissions are capped to 10 MB. Enable Firebase App Check in
      // enforcement mode to prevent uploads from untrusted clients.
      allow create: if request.resource.size > 0
                    && request.resource.size <= 10 * 1024 * 1024
                    && (request.resource.contentType.matches('application/pdf')
                        || request.resource.contentType.matches('image/png')
                        || request.resource.contentType.matches('image/jpeg')
                        || request.resource.contentType.matches('image/jpg')
                        || request.resource.contentType.matches('image/webp'));

      // Delete & Update restricted to the admin account.
      allow update, delete: if isAdmin();
    }
  }
}
