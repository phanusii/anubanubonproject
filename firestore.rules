rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // The email allowed to perform admin operations. Update this to your admin account.
    // (Rules are public config, not a secret — the actual protection is Firebase Auth.)
    function adminEmail() {
      return '18403p@gmail.com';
    }

    // True only for the signed-in admin account.
    function isAdmin() {
      return request.auth != null
             && request.auth.token.email == adminEmail();
    }

    // Basic shape/length validation for a public submission.
    // (Document-size / base64-bloat control is handled app-side by uploading to
    // Storage rather than inlining blobs; size caps here would silently reject
    // fallback writes and cause confusing data loss, so they are intentionally omitted.)
    function isValidSubmission() {
      return request.resource.data.keys().hasOnly([
               'fullName', 'position', 'school', 'province', 'gradeLevel',
               'subjectGroup', 'projectTitle', 'description', 'projectId',
               'projectName', 'fileType', 'fileURL', 'fileName', 'fileSize',
               'thumbnail', 'uploadDate', 'createdAt', 'driveLink',
               'driveFileId', 'submissionMethod'
             ])
             && request.resource.data.fullName is string
             && request.resource.data.fullName.size() > 0
             && request.resource.data.fullName.size() <= 200
             && request.resource.data.projectTitle is string
             && request.resource.data.projectTitle.size() <= 500
             && request.resource.data.school is string
             && request.resource.data.school.size() <= 300
             && request.resource.data.position is string
             && request.resource.data.position.size() <= 200
             && request.resource.data.gradeLevel is string
             && request.resource.data.gradeLevel.size() <= 100
             && request.resource.data.subjectGroup is string
             && request.resource.data.subjectGroup.size() <= 300
             && request.resource.data.fileType is string
             && request.resource.data.fileType in ['pdf', 'png', 'jpg', 'jpeg', 'webp', 'drive']
             && request.resource.data.fileURL is string
             && request.resource.data.fileURL.size() <= 3000
             && (!('description' in request.resource.data)
                 || request.resource.data.description.size() <= 3000);
    }

    // Settings collection
    match /settings/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Grade Levels collection
    match /gradeLevels/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Subject Groups collection
    match /subjectGroups/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Training rounds / projects collection
    match /projects/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Teachers collection
    match /teachers/{document} {
      allow read: if true;
      allow create, delete: if isAdmin();
      // Admins can edit freely; the public submit flow may set ONLY these self-service
      // fields on an existing teacher: subject group (auto-fill) and profile picture.
      allow update: if isAdmin();
    }

    // Submissions collection
    match /submissions/{submissionId} {
      // Public can read all submissions and create validated new ones.
      allow read: if true;
      allow create: if isValidSubmission();

      // Update and delete strictly restricted to the admin account.
      allow update, delete: if isAdmin();
    }
  }
}
