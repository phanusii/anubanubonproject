rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // The email allowed to perform admin operations. Update this to your admin account.
    // (Rules are public config, not a secret — the actual protection is Firebase Auth.)
    function adminEmail() {
      return 'phanu9818@anubanubon.ac.th';
    }

    // True only for the signed-in admin account.
    function isAdmin() {
      return request.auth != null
             && request.auth.token.email == adminEmail();
    }

    // Basic shape/length validation for a public submission.
    // (Document-size / base64-bloat control is handled app-side by uploading to
    // Storage rather than inlining blobs; size caps here would silently reject
    // fallback writes and cause confusing data loss, so they are intentionally omitted.)
    function isValidSubmission() {
      return request.resource.data.keys().hasOnly([
               'fullName', 'teacherId', 'position', 'school', 'province', 'gradeLevel',
               'subjectGroup', 'projectTitle', 'description', 'projectId',
               'projectName', 'workSlotId', 'fileType', 'fileURL', 'fileName', 'fileSize',
               'thumbnail', 'thumbUrl', 'uploadDate', 'createdAt', 'driveLink',
               'driveFileId', 'submissionMethod'
             ])
             && request.resource.data.fullName is string
             && request.resource.data.fullName.size() > 0
             && request.resource.data.fullName.size() <= 200
             && (!('teacherId' in request.resource.data)
                 || (request.resource.data.teacherId is string
                     && request.resource.data.teacherId.size() > 0
                     && request.resource.data.teacherId.size() <= 200))
             && request.resource.data.projectTitle is string
             && request.resource.data.projectTitle.size() <= 500
             && request.resource.data.school is string
             && request.resource.data.school.size() <= 300
             && request.resource.data.position is string
             && request.resource.data.position.size() <= 200
             && request.resource.data.gradeLevel is string
             && request.resource.data.gradeLevel.size() <= 100
             && request.resource.data.subjectGroup is string
             && request.resource.data.subjectGroup.size() <= 300
             && (!('workSlotId' in request.resource.data)
                 || (request.resource.data.workSlotId is string
                     && request.resource.data.workSlotId.size() > 0
                     && request.resource.data.workSlotId.size() <= 100))
             && request.resource.data.fileType is string
             && request.resource.data.fileType in ['pdf', 'png', 'jpg', 'jpeg', 'webp', 'drive']
             && request.resource.data.fileURL is string
             && request.resource.data.fileURL.size() <= 3000
             && (request.resource.data.fileURL.matches('https://drive\\.google\\.com/.*')
                 || request.resource.data.fileURL.matches('https://firebasestorage\\.googleapis\\.com/.*'))
             && request.resource.data.projectId is string
             && request.resource.data.projectId.size() > 0
             && request.resource.data.workSlotId is string
             && request.resource.data.createdAt is int
             && request.resource.data.createdAt >= request.time.toMillis() - 300000
             && request.resource.data.createdAt <= request.time.toMillis() + 300000
             && (!('fileSize' in request.resource.data)
                 || (request.resource.data.fileSize is number
                     && request.resource.data.fileSize >= 0
                     && request.resource.data.fileSize <= 25 * 1024 * 1024))
             && (!('thumbnail' in request.resource.data)
                 || (request.resource.data.thumbnail is string
                     && request.resource.data.thumbnail.size() <= 200000))
             && (!('description' in request.resource.data)
                 || request.resource.data.description.size() <= 3000);
    }

    // Settings collection
    match /settings/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Pre-aggregated gallery snapshot (chunked). Public read so the gallery can
    // load in a few reads instead of one-per-work; only the admin may (re)build it.
    match /gallerySnapshot/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /adminSubmissionSummary/{document} {
      allow read, write: if isAdmin();
    }

    // Queryable, lightweight gallery index: one row per teacher and round.
    // It is display-only; submissions remain authoritative. Public submitters
    // may refresh only the same immutable person/round identity after a valid
    // submission, while migration/deletion remains admin-only.
    match /projectParticipants/{document} {
      function validParticipantSummary() {
        return request.resource.data.keys().hasOnly([
                 'projectId', 'participantKey', 'fullName', 'teacherId', 'position',
                 'school', 'gradeLevel', 'subjectGroup', 'normalizedName',
                 'submissionIds', 'submittedCount', 'latestCreatedAt',
                 'latestUploadDate', 'works', 'updatedAt'
               ])
               && request.resource.data.projectId is string
               && request.resource.data.projectId.size() > 0
               && request.resource.data.participantKey is string
               && request.resource.data.fullName is string
               && request.resource.data.fullName.size() > 0
               && request.resource.data.fullName.size() <= 200
               && request.resource.data.submissionIds is list
               && request.resource.data.submissionIds.size() <= 50
               && request.resource.data.works is list
               && request.resource.data.works.size() <= 50
               && request.resource.data.submittedCount is int
               && request.resource.data.submittedCount >= 0
               && request.resource.data.latestCreatedAt is int
               && request.resource.data.updatedAt is int;
      }
      allow read: if true;
      allow create: if validParticipantSummary();
      allow update: if isAdmin()
                    || (validParticipantSummary()
                        && request.resource.data.projectId == resource.data.projectId
                        && request.resource.data.participantKey == resource.data.participantKey);
      allow delete: if isAdmin();
    }

    match /projectParticipantMeta/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Compact per-round statistics. No file URLs or thumbnails are stored here.
    match /projectStats/{document} {
      function validProjectStats() {
        return request.resource.data.keys().hasOnly([
                 'projectId', 'participants', 'totalWorks', 'updatedAt'
               ])
               && request.resource.data.projectId is string
               && request.resource.data.projectId.size() > 0
               && request.resource.data.participants is list
               && request.resource.data.participants.size() <= 500
               && request.resource.data.totalWorks is int
               && request.resource.data.totalWorks >= 0
               && request.resource.data.updatedAt is int;
      }
      allow read: if true;
      allow create: if validProjectStats();
      allow update: if isAdmin()
                    || (validProjectStats()
                        && request.resource.data.projectId == resource.data.projectId);
      allow delete: if isAdmin();
    }

    // Chunked public roster cache. Reading this costs one document read for the
    // current roster instead of one read per teacher; only admins may rebuild it.
    match /teacherSnapshot/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Grade Levels collection
    match /gradeLevels/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Subject Groups collection
    match /subjectGroups/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Training rounds / projects collection
    match /projects/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Teachers collection
    match /teachers/{document} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Submissions collection
    match /submissions/{submissionId} {
      // Public can read all submissions and create validated new ones.
      allow read: if true;
      allow create: if isValidSubmission();

      // Public replacements may update only the same person's same slot in the
      // same round. Document ids are generated by Firestore; deletion remains admin-only.
      allow update: if isAdmin()
                    || (isValidSubmission()
                        && request.resource.data.fullName == resource.data.fullName
                        && request.resource.data.projectId == resource.data.projectId
                        && request.resource.data.workSlotId == resource.data.workSlotId
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                          'description', 'fileType', 'fileURL', 'fileName', 'fileSize',
                          'thumbnail', 'thumbUrl', 'uploadDate', 'createdAt', 'driveLink',
                          'driveFileId', 'submissionMethod'
                        ]));
      allow delete: if isAdmin();
    }

    // Certificates are issued only by the trusted Apps Script service. Public
    // visitors may read them for download/verification; admins may revoke them.
    match /certificates/{certificateId} {
      allow read: if true;
      allow create: if false;
      allow update, delete: if isAdmin();
    }

    match /certificateCounters/{counterId} {
      allow read, write: if false;
    }
  }
}
